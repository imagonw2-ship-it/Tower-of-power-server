# For local development, leave NODE_ENV unset. Use HTTPS in production.
PORT=8080
DATABASE_PATH=data/accounts.sqlite
ALLOWED_ORIGINS=https://appassets.androidplatform.net
# Set true only behind your trusted TLS reverse proxy (e.g. Railway).
TRUST_PROXY=false
# Optional: permits the downloadable HTML opened directly as a file.
ALLOW_FILE_ORIGIN=false
